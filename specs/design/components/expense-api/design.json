{
  "name": "expense-api",
  "type": "service",
  "version": "0.1.0",
  "language": "Ballerina",
  "buildpack": "docker",
  "appPath": "expense-api",
  "entrypoint": "deployment/service",
  "exposure": "internet",
  "stories": [
    5,
    6,
    7,
    8,
    9,
    10,
    11
  ],
  "description": "Owns claims, policy rules and decisions. Creates and lists expense claims, checks each submitted claim against the active policy rules and raises a flag with a plain-language reason when one breaks, lists a manager's own team's pending claims, records approve/reject decisions, and lets Finance/Admin maintain policy rules and see claims across every team. It does not read receipt files itself — the webapp pre-fills claim fields via receipt-agent before calling this API — and it does not send any notification.",
  "dependencies": [
    {
      "kind": "platform-resource",
      "name": "user-auth",
      "resourceType": "thunder-app",
      "wiring": {
        "ref": "expense-claims-te-78f6fe06",
        "envBindings": {
          "client_id": "USER_AUTH_CLIENT_ID",
          "issuer": "USER_AUTH_ISSUER",
          "jwks_url": "USER_AUTH_JWKS_URL",
          "resource": "USER_AUTH_RESOURCE",
          "scopes": "USER_AUTH_SCOPES"
        }
      }
    },
    {
      "kind": "platform-resource",
      "name": "expense-db",
      "resourceType": "postgres-cnpg",
      "wiring": {
        "ref": "expense-claims-te-842ee293",
        "envBindings": {
          "dbname": "EXPENSE_DB_DBNAME",
          "host": "EXPENSE_DB_HOST",
          "password": "EXPENSE_DB_PASSWORD",
          "port": "EXPENSE_DB_PORT",
          "user": "EXPENSE_DB_USER"
        }
      }
    }
  ],
  "exposesAPI": {
    "auth": "end-user-required"
  },
  "skillsPinned": [
    "openapi-conventions",
    "ballerina",
    "thunder-authentication",
    "api-management"
  ]
}
